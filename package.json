{
  "name": "indigo-stack-ce",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm check && astro dev",
    "check": "pnpm cf-types && astro check --minimumSeverity warning",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm cf-types && astro build",
    "preview": "astro build && wrangler dev",
    "preview:test": "astro build && wrangler dev --port 8787",
    "astro": "astro",
    "preview-email": "email dev --dir src/components/email",
    "d1": "wrangler d1",
    "cf-types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:init:local": "wrangler d1 execute indigo-ce --local --command 'SELECT COUNT(*)'",
    "db:init:prod": "wrangler d1 create indigo-ce",
    "db:migrate:local": "wrangler d1 migrations apply indigo-ce --local",
    "db:migrate-dry:local": "wrangler d1 migrations list indigo-ce --local",
    "db:migrate:prod": "wrangler d1 migrations apply indigo-ce --remote",
    "db:backup": "node scripts/backup.js",
    "icons": "node scripts/generate-icons.mjs",
    "icons:dry": "node scripts/generate-icons.mjs --dry",
    "db:migrate-dry:prod": "wrangler d1 migrations list indigo-ce --remote",
    "db:studio:local": "drizzle-kit studio",
    "better-auth:schema": "pnpm dlx @better-auth/cli generate --config src/lib/auth-config.ts",
    "add-component": "pnpm dlx shadcn@latest add",
    "email-worker:check": "tsc --noEmit -p workers/indigo-email-queue-consumer/tsconfig.json",
    "email-worker:dev": "wrangler dev --config workers/indigo-email-queue-consumer/wrangler.jsonc",
    "email-worker:deploy": "wrangler deploy --config workers/indigo-email-queue-consumer/wrangler.jsonc",
    "queue:create": "wrangler queues create indigo-email-queue && wrangler queues create indigo-email-queue-dlq",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "bash scripts/codegen.sh"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^7.0.1",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "better-auth": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.13.13",
    "input-otp": "^1.5.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-resizable-panels": "^4.14.5",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@cretezy/cloudflare-d1-backup": "^0.2.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "4.1.11",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-email": "^6.11.2",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "vitest": "~4.1.11",
    "wrangler": "^4.151.0"
  }
}
