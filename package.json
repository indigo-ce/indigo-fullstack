{
  "name": "indigo-stack-ce",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm check && astro dev",
    "check": "pnpm cf-types && astro check --minimumSeverity warning",
    "build": "pnpm cf-types && astro build",
    "preview": "astro build && wrangler dev",
    "preview:test": "astro build && wrangler dev --port 8787",
    "astro": "astro",
    "preview-email": "email dev --dir src/components/email",
    "d1": "wrangler d1",
    "cf-types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:init:local": "wrangler d1 execute indigo-ce --local --command 'SELECT COUNT(*)'",
    "db:init:prod": "wrangler d1 create indigo-ce",
    "db:migrate:local": "wrangler d1 migrations apply indigo-ce --local",
    "db:migrate-dry:local": "wrangler d1 migrations list indigo-ce --local",
    "db:migrate:prod": "wrangler d1 migrations apply indigo-ce --remote",
    "db:migrate-dry:prod": "wrangler d1 migrations list indigo-ce --remote",
    "db:studio:local": "drizzle-kit studio",
    "better-auth:schema": "pnpm dlx @better-auth/cli generate --config src/lib/auth-config.ts",
    "email-worker:check": "tsc --noEmit -p workers/indigo-email-queue-consumer/tsconfig.json",
    "email-worker:dev": "wrangler dev --config workers/indigo-email-queue-consumer/wrangler.jsonc",
    "email-worker:deploy": "wrangler deploy --config workers/indigo-email-queue-consumer/wrangler.jsonc",
    "queue:create": "wrangler queues create indigo-email-queue && wrangler queues create indigo-email-queue-dlq",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "bash scripts/codegen.sh"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "@hookform/resolvers": "^5.9.1",
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.13.5",
    "input-otp": "^1.5.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.40.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vaul": "^1.1.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260904.1",
    "@cretezy/cloudflare-d1-backup": "^0.2.1",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/ui": "4.1.11",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-email": "^6.9.3",
    "tw-animate-css": "^1.4.0",
    "vitest": "~4.1.11",
    "wrangler": "^4.129.0"
  }
}
